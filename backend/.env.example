# SecureOTP Flask Backend Configuration

# Login Key required to access the dashboard
LOGIN_KEY=admin123

# Flask Session Secret Key
SECRET_KEY=secureotp_flask_session_secret_key_change_in_prod

# Shared RFC 6238 Base32 Secret Key (Must match ESP32 secrets_config.h)
TOTP_SECRET=JBSWY3DPEHPK3PXP

# IP address of the ESP32 on your local Wi-Fi network (Leave empty or 'demo' if hardware not connected)
# Example: ESP32_IP=192.168.1.105
ESP32_IP=

# Demo Mode: Set to 'true' to allow backend local TOTP generation when ESP32 is offline
DEMO_MODE=false

# Server Host & Port
APP_HOST=0.0.0.0
APP_PORT=5000
